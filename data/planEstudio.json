  "peso_academico_utn_frba": {
    "normativa_nuevo_modelo": "Resolución N° 2902/25 (Consejo Directivo UTN FRBA)",
    "fecha_aprobacion": "03/12/2025",
    "fecha_inversion_roles": "2027-01-01",
    "modelo_vigente_2026": "calculo_anterior",
    "modelo_vigente_2027": "calculo_nuevo",
    "calculo_anterior": {
      "formula": "PESO = 11 * CMA - 5 * AA - 3 * CMD",
      "vigencia": "Vigente hasta el 31/12/2026",
      "variables": {
        "CMA": "Cantidad de Materias (finales) Aprobadas",
        "AA": "Años de antigüedad en la Facultad",
        "CMD": "Cantidad de Materias (finales) Desaprobadas"
      }
    },
    "calculo_nuevo": {
      "formula": "P = 11 * MAp_total - 7 * FAd_total - 19 * FAu_ciclo - 17 * MAb_ciclo + 5 * MR_ciclo",
      "vigencia": "Entra en vigencia el 01/01/2027",
      "variables": {
        "MAp_total": "Cantidad total de materias aprobadas desde el inicio de la carrera",
        "FAd_total": "Cantidad de finales adeudados desde el inicio de la carrera",
        "FAu_ciclo": "Cantidad de finales ausente en el último ciclo lectivo",
        "MAb_ciclo": "Cantidad de materias abandonadas en el último ciclo lectivo",
        "MR_ciclo": "Cantidad de materias regularizadas en el último ciclo lectivo"
      }
    }
  },
